{
    "hosting": [
        {
            "target": "main",
            "public": "out",
            "rewrites": [
                {
                    "source": "**",
                    "destination": "/$&.html"
                }
            ],
            "redirects": [
                {
                    "source": "/",
                    "destination": "/tr",
                    "type": 301
                }
            ],
            "cleanUrls": true,
            "ignore": [
                "firebase.json",
                "**/.*",
                "**/terraform/**",
                "**/node_modules/**"
            ]
        }
    ]
}